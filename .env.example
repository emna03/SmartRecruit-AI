# ============================================================
# SmartRecruit AI - variables d'environnement (MODÈLE)
# Copier ce fichier en ".env" puis remplir les valeurs.
# Le fichier .env est ignoré par Git : ne jamais le commiter.
# ============================================================

# ---------- MySQL ----------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=smartrecruit
DB_USER=smartrecruit
DB_PASSWORD=change_me
# Utilisé uniquement par le conteneur Docker MySQL (jamais par l'application)
DB_ROOT_PASSWORD=change_me_root

# ---------- Backend Spring Boot ----------
SERVER_PORT=8080
# Secret JWT : au moins 32 caractères aléatoires (ex: openssl rand -base64 48)
JWT_SECRET=change_me_with_a_long_random_secret_of_at_least_32_chars
JWT_EXPIRATION_MS=86400000
# Compte administrateur créé au premier démarrage (si aucun admin n'existe). Laisser vide pour ne rien créer.
ADMIN_EMAIL=admin@smartrecruit.local
ADMIN_PASSWORD=change_me_Admin123
CORS_ALLOWED_ORIGINS=http://localhost:4200
UPLOAD_DIR=./uploads
# Taille maximale d'un CV PDF (1 à 20 Mo), appliquée par Spring Boot et FastAPI
MAX_CV_SIZE_MB=5

# ---------- Service IA FastAPI ----------
# URL utilisée par Spring Boot ; FastAPI en déduit son port d'écoute.
# 127.0.0.1 plutôt que localhost : sous Windows, localhost tente d'abord IPv6 (::1) et ajoute ~2 s par connexion.
AI_SERVICE_URL=http://127.0.0.1:8000
# Clé partagée Spring Boot <-> FastAPI (le frontend n'appelle jamais FastAPI directement).
# Au moins 16 caractères aléatoires (ex: openssl rand -hex 32) ; FastAPI refuse de démarrer avec la valeur d'exemple.
AI_INTERNAL_API_KEY=change_me_internal_key
# Délai maximal d'attente d'une réponse du service IA côté Spring Boot (1 à 120 s)
AI_TIMEOUT_SECONDS=20
# Options du service FastAPI (valeurs par défaut sûres) :
# AI_SERVICE_HOST=127.0.0.1    interface d'écoute (0.0.0.0 uniquement dans un conteneur)
# AI_LOG_LEVEL=info
# AI_DOCS_ENABLED=false        true pour activer Swagger UI sur /docs en développement
# AI_CV_MAX_PAGES=10           nombre maximal de pages d'un CV analysé (1 à 50)

# ---------- LLM (optionnel, utilisé uniquement par le chatbot) ----------
# Si vide, le chatbot fonctionne en mode "règles + base de connaissances" sans LLM.
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=15
